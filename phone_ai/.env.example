# ── Anthropic ──────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Twilio ─────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The Twilio phone number the AI answers on (in E.164 format, e.g. +13233486756)
TWILIO_NUMBER=+13233486756

# Phone number to forward to when caller asks for a human (your cell or back-office line)
TRANSFER_NUMBER=+13233486756

# Set to "false" during local testing with ngrok; always "true" in production
VALIDATE_TWILIO_REQUESTS=true

# Port for the Flask server
PORT=5000
